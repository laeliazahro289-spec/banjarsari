APP_NAME="Banom NU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database SQLite (tidak perlu MySQL). Berkas: database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Bila ingin memakai MySQL (Laragon), hapus DB_CONNECTION=sqlite di atas lalu aktifkan: ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=websitenu
# DB_USERNAME=root
# DB_PASSWORD=
